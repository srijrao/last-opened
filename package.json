{
  "name": "last-opened",
  "version": "1.0.1",
  "description": "Obsidian plugin to track when notes are opened and closed",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest --silent >NUL 2>&1 && echo 'all tests passed' || jest --silent",
    "test:watch": "jest --watch --silent",
    "test:ci": "jest --ci --coverage",
    "test:verbose": "jest"
  },
  "keywords": [],
  "author": "Justin Changalpet (https://github.com/srijrao)",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "@typescript-eslint/parser": "8.62.0",
    "builtin-modules": "5.3.0",
    "esbuild": "0.28.1",
    "eslint": "8.57.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "obsidian": "latest",
    "ts-jest": "^29.4.11",
    "tslib": "2.8.1",
    "typescript": "^6.0.3"
  }
}
